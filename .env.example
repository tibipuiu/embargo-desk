# For local development only. On the server, set these in Coolify instead.

# Long random string for signing login cookies: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First admin account, created on first start if no accounts exist yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# true on the server (HTTPS); false for local testing over http://localhost.
SECURE_COOKIES=false
TZ=Europe/Bucharest

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
EMBARGOED_ONLY=true
MAX_DEEP_REVIEWS=25
