# For local development only. On the server, set these in Coolify's
# Environment Variables tab instead (they map onto docker-compose.yml).

# --- Web app -----------------------------------------------------------------
# Long random string for signing login cookies: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# First admin account, created on first start if no accounts exist yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# true on the server (HTTPS); false for local testing over http://localhost.
SECURE_COOKIES=false
# Time zone and daily run times (24 h), comma-separated.
TZ=Europe/Bucharest
RUN_TIMES=07:00

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- EurekAlert! -------------------------------------------------------------
# The server logs in by itself with these when its session expires.
EUREKA_EMAIL=
EUREKA_PASSWORD=
EUREKA_LISTING_URLS=https://www.eurekalert.org/reporter/embargoed-news
EMBARGOED_ONLY=true
MAX_LISTING_PAGES=5
MAX_NEW_RELEASES=150
MAX_DEEP_REVIEWS=25
REQUEST_DELAY_SECONDS=1.5
